{
  "name": "textboard",
  "version": "3.3.0",
  "description": "The Local-First Visual Intelligence & Communication Stream Analytics Workstation",
  "main": "electron/main.js",
  "author": "Qamar Abbas",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "electron:dev": "electron .",
    "electron:pack": "electron-builder --dir",
    "electron:dist": "node scripts/prepare-standalone.js && electron-builder",
    "build:all": "npm run build --prefix backend && npm run build --prefix frontend && node scripts/prepare-standalone.js",
    "build:exe": "npm run build:all && electron-builder",
    "build:portable": "npm run build:all && electron-builder --win portable",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "dependencies": {
    "adm-zip": "^0.6.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "electron": "33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.qamarabbas.textboard",
    "productName": "TextBoard",
    "electronVersion": "33.2.1",
    "forceCodeSigning": false,
    "copyright": "Copyright © 2026 Qamar Abbas",
    "compression": "store",
    "directories": {
      "output": "dist-desktop"
    },
    "artifactName": "TextBoard-Setup-${version}.${ext}",
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "TextBoard",
      "uninstallDisplayName": "TextBoard Workstation",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "TextBoard-Portable-${version}.${ext}"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/*.dll"
    ],
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "dist/**/*",
          "node_modules/**/*",
          "prisma/**/*",
          "package.json"
        ]
      },
      {
        "from": "frontend/.next/standalone",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}

