{
  "name": "textboard",
  "version": "3.2.0",
  "description": "The Local-First Visual Intelligence & Communication Stream Analytics Workstation",
  "main": "electron/main.js",
  "author": "Qamar Abbas",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "electron:dev": "electron .",
    "electron:pack": "electron-builder --dir",
    "electron:dist": "electron-builder",
    "build:all": "npm run build --prefix backend && npm run build --prefix frontend",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "dependencies": {
    "adm-zip": "^0.6.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "electron": "33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.qamarabbas.textboard",
    "productName": "TextBoard",
    "electronVersion": "33.2.1",
    "copyright": "Copyright © 2026 Qamar Abbas",
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TextBoard Workstation"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ]
  }
}

