{
  "name": "textboard",
  "version": "3.3.0",
  "description": "The Local-First Visual Intelligence & Communication Stream Analytics Workstation",
  "main": "electron/main.js",
  "author": "Qamar Abbas",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "electron:dev": "electron .",
    "electron:pack": "electron-builder --dir",
    "electron:dist": "electron-builder",
    "build:all": "npm run build --prefix backend && npm run build --prefix frontend",
    "build:exe": "npm run build:all && electron-builder",
    "build:portable": "npm run build:all && electron-builder --win portable",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "dependencies": {
    "adm-zip": "^0.6.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "electron": "33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.qamarabbas.textboard",
    "productName": "TextBoard",
    "electronVersion": "33.2.1",
    "forceCodeSigning": false,
    "copyright": "Copyright © 2026 Qamar Abbas",
    "compression": "store",
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TextBoard Workstation"
    },
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend/dist"
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "backend/prisma",
        "to": "backend/prisma"
      },
      {
        "from": "backend/package.json",
        "to": "backend/package.json"
      },
      {
        "from": "frontend/.next/standalone",
        "to": "frontend/standalone"
      },
      {
        "from": "frontend/.next/static",
        "to": "frontend/standalone/.next/static"
      },
      {
        "from": "frontend/public",
        "to": "frontend/standalone/public"
      }
    ],
    "files": [
      "electron/**/*",
      "package.json"
    ]
  }
}

