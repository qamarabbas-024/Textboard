# ==============================================
# Textboard - Environment Configuration
# ==============================================

# Database (PostgreSQL)
POSTGRES_USER=textboard_user
POSTGRES_PASSWORD=textboard_password
POSTGRES_DB=textboard_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://textboard_user:textboard_password@localhost:5432/textboard_db?schema=public

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Backend Configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
