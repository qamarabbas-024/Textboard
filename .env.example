# ==============================================
# Archive - Environment Configuration
# ==============================================

# Database (PostgreSQL)
POSTGRES_USER=archive_user
POSTGRES_PASSWORD=archive_password
POSTGRES_DB=archive_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://archive_user:archive_password@localhost:5432/archive_db?schema=public

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Backend Configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
